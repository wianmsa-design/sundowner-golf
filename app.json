{
  "expo": {
    "name": "Sundowner Golf",
    "slug": "sundowner-golf-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sundownergolf.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Sundowner Golf",
      "shortName": "Sundowner",
      "backgroundColor": "#1a1a1a",
      "themeColor": "#1a1a1a"
    },
    "extra": {
      "eas": {
        "projectId": "47fedc07-9d0d-4791-86cf-b7f92679b390"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "baseUrl": "/sundowner-golf"
    }
  }
}